[Unit]
Description=AI-BCC V2 Sentinel host probe
After=docker.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/home/bosscatdog/deployments/ai-business-command-center-v2/backend/deploy
Environment=COMPOSE_PROJECT_NAME=ai-bcc-v2
Environment=SENTINEL_HOST_RUNTIME_DIR=/run/ai-bcc-v2
ExecStart=/home/bosscatdog/deployments/ai-business-command-center-v2/backend/deploy/host-probe.sh /home/bosscatdog/deployments/ai-business-command-center-v2/backend/deploy/.env.production
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/run/ai-bcc-v2
